{
  "name": "@nicolassancho/storybook-core",
  "version": "4.2.0",
  "description": "Accessible React + Tailwind component library built with tailwind-variants and documented in Storybook.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles/theme.css": "./dist/styles/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/theme.css dist/styles/theme.css",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "lint": "eslint ./src",
    "format": "prettier --write ./src ./.storybook",
    "test:package": "npm run build && publint --pack npm && attw --pack . --profile esm-only --exclude-entrypoints ./styles/theme.css && node scripts/test-package.mjs"
  },
  "keywords": [
    "react",
    "tailwindcss",
    "tailwind-variants",
    "components",
    "storybook",
    "design-system"
  ],
  "author": "NicolasSancho (https://github.com/NicolasSancho)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NicolasSancho/Storybook-core.git"
  },
  "homepage": "https://nicolassancho.github.io/Storybook-core/",
  "bugs": {
    "url": "https://github.com/NicolasSancho/Storybook-core/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/browser-playwright": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-storybook": "^10.6.2",
    "playwright": "^1.64.0",
    "postcss": "^8.4.41",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3"
  }
}
